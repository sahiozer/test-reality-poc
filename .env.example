# Synthetic, loopback-only local demo default. Not a production credential.
# Copy to .env; never commit .env. Use a URL-safe random hexadecimal password
# if changing this value. Changing it does not reset an existing PostgreSQL user.
DATABASE_PASSWORD=local_demo_only_change_me
FRONTEND_PORT=18080
BACKEND_PORT=18081

# Core mode is the default. For optional AI mode set BOTH:
# LLM_ENABLED=true
# COMPOSE_PROFILES=ai
# Then start the stack and explicitly pull qwen2.5:0.5b (see docs/LOCAL_SETUP.md).
LLM_ENABLED=false
COMPOSE_PROFILES=
